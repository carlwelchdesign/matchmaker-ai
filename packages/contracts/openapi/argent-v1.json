{
  "openapi": "3.0.3",
  "info": {
    "title": "Argent API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "ServiceHealth": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "state": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "state",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "System"
        ],
        "description": "Confirms that the API process can serve requests. This is not dependency readiness.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealth"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ]
}

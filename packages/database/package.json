{
  "name": "@argent/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate:down": "tsx src/cli/migrate.ts down",
    "migrate:up": "tsx src/cli/migrate.ts up",
    "seed": "tsx src/cli/seed.ts",
    "test": "vitest run src --exclude src/integration.test.ts --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --no-file-parallelism src/integration.test.ts src/delivery.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
